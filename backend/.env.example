# Copy to backend/.env on the server and fill in real values.
# .env and .env.* are gitignored — never commit a filled-in copy.
#
# Every value below was previously hardcoded in source or committed in
# .env.bak.20260812. Treat the old values as public and rotate all of them.

# --- Database -----------------------------------------------------------
DB_USER=
DB_PASSWORD=
DB_SERVER=
DB_NAME=Society
DB_PORT=1433
# Encrypt the connection. Leave unset (defaults to on).
DB_ENCRYPT=true
# Accept an unverified server certificate. ONLY for a local instance with a
# self-signed cert — leaving this on in production allows interception.
DB_TRUST_SERVER_CERT=false

# --- Tokens -------------------------------------------------------------
# Rotating JWT_SECRET_KEY invalidates every issued token and signs everyone out.
JWT_SECRET_KEY=
REFRESH_KEY=
WEB_ACCESS_TOKEN_TTL=15m
WEB_REFRESH_TOKEN_DAYS=7

# --- Firebase (push notifications) --------------------------------------
# Either the service-account JSON itself (raw or base64), or a path to it.
# The file must live outside the repository.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_PATH=

# --- Payments -----------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- SMS (MessageBot) ---------------------------------------------------
MSGBOT_API_KEY=
MSGBOT_SOURCE_ID=SMSALA
# DLT registration for the login OTP template.
MSGBOT_DLT_ENTITY_ID=
MSGBOT_DLT_TEMPLATE_ID=

# --- HTTP ---------------------------------------------------------------
PORT=8000
# Comma-separated origins allowed to call this API. Empty means same-origin
# only. The mobile apps are not browsers and are unaffected by CORS.
CORS_ORIGINS=https://app.chshub.co.in

# Shared secret for the /api/web/cron endpoints.
CRON_TOKEN=
