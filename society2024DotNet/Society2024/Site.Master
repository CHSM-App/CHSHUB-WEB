		<div id="cropModal">
			<div id="cropBox">
				<p><strong>Drag the image to adjust</strong></p>
				<img id="preview" />
				<div class="btn-group">
					<asp:Button runat="server" class="btn-upload" OnClientClick="uploadCroppedImage()" Text="Upload ✅" UseSubmitBehavior="False"></asp:Button>
					<button class="btn-cancel" onclick="closeModal()">Cancel ❌</button>
				</div>

			</div>
		</div>

	</form>


	<script>
        // Sidebar collapse toggle functionality with persistent state
        (function () {
            'use strict';

            // Wait for DOM to be fully loaded
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init);
            } else {
                init();
            }

            function init() {
                const currentPage = window.location.pathname.split('/').pop();

                // Restore sidebar state from localStorage
                restoreSidebarState();

                // Set active page styling
                setActivePage(currentPage);

                // Get all collapsible sidebar items
                const sidebarItems = document.querySelectorAll('.sidebar-item.collapsed');

                sidebarItems.forEach(function (item) {
                    // Remove any existing event listeners by cloning
                    const newItem = item.cloneNode(true);
                    item.parentNode.replaceChild(newItem, item);

                    newItem.addEventListener('click', function (e) {
                        e.preventDefault();
                        e.stopPropagation();

                        try {
                            // Get the target collapse element
                            const target = this.getAttribute('data-target');

                            if (!target) {
                                console.warn('No data-target attribute found');
                                return;
                            }

                            const collapseElement = document.querySelector(target);

                            if (!collapseElement) {
                                console.warn('Collapse element not found for target:', target);
                                return;
                            }

                            // Check if this collapse is currently open
                            const isCurrentlyOpen = collapseElement.classList.contains('show');

                            // Get the parent accordion
                            const parentAccordion = collapseElement.getAttribute('data-parent');

                            // Close all other collapses in the same accordion
                            if (parentAccordion) {
                                const allCollapses = document.querySelectorAll(parentAccordion + ' .collapse');
                                allCollapses.forEach(function (collapse) {
                                    if (collapse !== collapseElement) {
                                        collapse.classList.remove('show');
                                        const collapseTarget = '#' + collapse.id;
                                        const correspondingItem = document.querySelector('[data-target="' + collapseTarget + '"]');
                                        if (correspondingItem) {
                                            correspondingItem.setAttribute('aria-expanded', 'false');
                                        }
                                        saveSidebarState(collapseTarget, false);
                                    }
                                });
                            }

                            // Toggle the clicked collapse
                            if (isCurrentlyOpen) {
                                // Close it
                                collapseElement.classList.remove('show');
                                this.setAttribute('aria-expanded', 'false');
                                saveSidebarState(target, false);
                            } else {
                                // Open it
                                collapseElement.classList.add('show');
                                this.setAttribute('aria-expanded', 'true');
                                saveSidebarState(target, true);
                            }
                        } catch (error) {
                            console.error('Error toggling sidebar:', error);
                        }
                    });
                });

                // Add click handlers to inner links for active styling
                const innerLinks = document.querySelectorAll('.collapse-inner a');
                innerLinks.forEach(function (link) {
                    link.addEventListener('click', function (e) {
                        try {
                            const href = this.getAttribute('href');

                            if (href) {
                                // Save active page
                                localStorage.setItem('activePage', href);

                                // Get parent collapse and save its open state
                                const parentCollapse = this.closest('.collapse');
                                if (parentCollapse && parentCollapse.id) {
                                    const parentTarget = '#' + parentCollapse.id;
                                    saveSidebarState(parentTarget, true);
                                }
                            }
                        } catch (error) {
                            console.error('Error saving active page:', error);
                        }
                    });
                });
            }

            // Function to save sidebar state to localStorage
            function saveSidebarState(target, isOpen) {
                try {
                    const sidebarState = JSON.parse(localStorage.getItem('sidebarState') || '{}');
                    sidebarState[target] = isOpen;
                    localStorage.setItem('sidebarState', JSON.stringify(sidebarState));
                } catch (error) {
                    console.error('Error saving sidebar state:', error);
                }
			}



            // Function to restore sidebar state from localStorage
            function restoreSidebarState() {
                try {
                    const sidebarState = JSON.parse(localStorage.getItem('sidebarState') || '{}');

                    Object.keys(sidebarState).forEach(function (target) {
                        const collapseElement = document.querySelector(target);
                        const sidebarItem = document.querySelector('[data-target="' + target + '"]');

                        if (collapseElement && sidebarItem) {
                            if (sidebarState[target]) {
                                collapseElement.classList.add('show');
                                sidebarItem.setAttribute('aria-expanded', 'true');
                            } else {
                                collapseElement.classList.remove('show');
                                sidebarItem.setAttribute('aria-expanded', 'false');
                            }
                        }
                    });
                } catch (error) {
                    console.error('Error restoring sidebar state:', error);
                    // Clear corrupted data
                    localStorage.removeItem('sidebarState');
                }
            }

            // Function to set active page styling
            function setActivePage(currentPage) {
                try {
                    const savedActivePage = localStorage.getItem('activePage');
                    const pageToHighlight = savedActivePage || currentPage;

                    // Remove any existing active styling
                    const allLinks = document.querySelectorAll('.collapse-inner a');
                    allLinks.forEach(function (link) {
                        link.style.backgroundColor = '';
                        link.style.color = '';
                        link.classList.remove('active-page');
                    });

                    // Find and style the current page link
                    let activeLink = null;

                    if (pageToHighlight) {
                        activeLink = document.querySelector('.collapse-inner a[href="' + pageToHighlight + '"]');
                    }

                    // Fallback: if saved page not found, try current page
                    if (!activeLink && currentPage) {
                        activeLink = document.querySelector('.collapse-inner a[href="' + currentPage + '"]');
                    }

                    if (activeLink) {
                        activeLink.style.backgroundColor = '#e0f2fe';
                        activeLink.style.color = '#1d4ed8';
                        activeLink.classList.add('active-page');

                        // Make sure parent collapse is open
                        const parentCollapse = activeLink.closest('.collapse');
                        if (parentCollapse && parentCollapse.id) {
                            parentCollapse.classList.add('show');
                            const parentTarget = '#' + parentCollapse.id;
                            const parentItem = document.querySelector('[data-target="' + parentTarget + '"]');
                            if (parentItem) {
                                parentItem.setAttribute('aria-expanded', 'true');
                            }
                            // Save this state to keep it open
                            saveSidebarState(parentTarget, true);
                        }

                        // Update localStorage with current page
                        const href = activeLink.getAttribute('href');
                        if (href) {
                            localStorage.setItem('activePage', href);
                        }
                    }
                } catch (error) {
                    console.error('Error setting active page:', error);
                }
            }
		})();

        function removeSidebarState() {
            try {
                const sidebarState = JSON.parse(localStorage.getItem('sidebarState') || '{}');

                // Set all keys to isOpen
                Object.keys(sidebarState).forEach(key => {
                    sidebarState[key] = false;
                });

				localStorage.setItem('sidebarState', JSON.stringify(sidebarState));
                localStorage.setItem('activePage', "");
            } catch (error) {
                console.error('Error saving sidebar state:', error);
            }
        }
    </script>


	<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
	<!-- Bootstrap core JavaScript-->

	<%--<script src="vendor/bootstrap/js/bootstrap.bundle.min.js"></script>--%>

	<!-- Core plugin JavaScript-->

	<!-- Custom scripts for all pages-->
	<script src="js/sb-admin-2.min.js"></script>
	<script src="js/site_master_js.js"></script>


	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
	<script>
		// JavaScript to duplicate text for seamless scrolling if text is too long
		document.addEventListener("DOMContentLoaded", () => {
			const container = document.querySelector(".society-name-pill");
			const text = document.querySelector(".society-name-text");

			if (!container || !text) return;

			const originalText = text.textContent.trim();

			// If text fits inside container, don't animate
			if (text.scrollWidth <= container.clientWidth) return;

			// Duplicate text for seamless scroll
			text.innerHTML = originalText + " &nbsp; • &nbsp; " + originalText;

			// After DOM updates, measure width
			requestAnimationFrame(() => {
				const fullWidth = text.scrollWidth;

				// Apply animation dynamically
				text.style.animation = `scrollAnim ${fullWidth / 50}s linear infinite`;
			});
		});

		// Keyframes using JS because text width is dynamic
		const style = document.createElement("style");
		style.innerHTML = `
@keyframes scrollAnim {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
}
`;
		document.head.appendChild(style);
	</script>
	<script>
		function openModalProfile() {
			$('#profile_model').modal('show');
		}

		const fileInput = document.getElementById('fileInput');
		const profileImage = document.getElementById('profileImage2');
		const cropModal = document.getElementById('cropModal');
		const profileModal = document.getElementById('profile_model');
		const preview = document.getElementById('preview');
		let cropper;

		fileInput.addEventListener('change', (event) => {
			const file = event.target.files[0];
			if (!file) return;
			const reader = new FileReader();
			reader.onload = () => {
				preview.src = reader.result;
				cropModal.style.display = 'flex';
				if (cropper) cropper.destroy();
				cropper = new Cropper(preview, {
					aspectRatio: 1,
					viewMode: 1,
					dragMode: 'move',
					responsive: true,
					zoomable: true,
				});
			};
			reader.readAsDataURL(file);
		});

		function closeModal() {
			cropModal.style.display = 'none';
			cropper.destroy();
		}

		function closeProfileModal(modalId) {
			const modal = document.getElementById(modalId);
			if (modal) {
				const bootstrapModal = bootstrap.Modal.getInstance(modal);

				if (bootstrapModal) {
					bootstrapModal.hide();
				} else {
					// If no instance exists, hide directly
					modal.classList.remove('show');
					modal.style.display = 'none';
				}

				// Clean up body classes and backdrops
				setTimeout(() => {
					document.body.classList.remove('modal-open');
					const backdrops = document.querySelectorAll('.modal-backdrop');
					backdrops.forEach(backdrop => backdrop.remove());
				}, 350);
			}
		}


		function uploadCroppedImage() { 
			const canvas = cropper.getCroppedCanvas({
				width: 150,
				height: 150,
			});

			const dataUrl = canvas.toDataURL('image/png');
			const ownerId = document.getElementById('<%= userID.ClientID %>').value;
            // Update image preview
            profileImage.src = dataUrl;
            closeModal();

            // Send to server with imageData and ownerId
            fetch('UploadImageHandler.ashx', {
                method: 'POST',
                body: JSON.stringify({
                    imageData: dataUrl,
                    ownerId: ownerId
                }),
                headers: {
                    'Content-Type': 'application/json'
                }
            })
                .then(response => response.text())
                .then(data => console.log("Server:", data))
                .catch(error => console.error("Upload failed:", error));
        }

        function SuccessEntry() {
            Swal.fire({
                title: '✅ Success!',
                text: 'Saved Successfully',
                icon: 'success',
                showConfirmButton: true,
                confirmButtonColor: '#3085d6',
                confirmButtonText: 'OK',
                timer: 1400,
                timerProgressBar: true,

                didOpen: () => {
                    Swal.showLoading()
                },
                willClose: () => {
                    window.location.reload();
                }
            });
        }


       
    </script>

</body>

</html>