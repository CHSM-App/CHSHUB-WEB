# Secrets — never commit
.env
*.env
!.env.example

# Dependencies
node_modules/

# Build output
dist/
build/

# React frontend build output, generated into backend/public/ by CI on every
# push so the backend branch can serve it directly — never commit it to main.
backend/public/

# .NET build output / IDE cruft (Society_dotNet)
[Bb]in/
[Oo]bj/
packages/
.vs/
*.user
*.suo
# Nested repo metadata, whatever directory it lives under — the packfile
# inside exceeds GitHub's 100 MB limit and blocks pushes
.git_disabled/

# Archives / bundles — never commit (GitHub rejects files over 100 MB)
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz

# Runtime-uploaded resident data (photos, documents, ID proofs)
backend/uploads/
backend/routes/ProfileImages/
backend/routes/Documents/
backend/routes/VisitorImage/
backend/routes/FamilyMembers/
backend/routes/HelpdeskImages/
backend/routes/ProductImages/

# Logs
*.log
logs/

# OS / editor cruft
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Firebase service-account keys — supply via FIREBASE_SERVICE_ACCOUNT or
# FIREBASE_SERVICE_ACCOUNT_PATH instead. Never commit these.
serviceAccountKey.json
**/serviceAccountKey.json
*serviceAccount*.json

# Env backups. The bare .env rule above misses these.
.env.*
!.env.example

# Android release signing — never commit keystores or filled-in key.properties
*.jks
*.keystore
**/key.properties
!**/key.properties.example

# Flutter golden-test failure output (regenerate goldens deliberately, never commit diffs)
**/test/failures/
