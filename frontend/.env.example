# Copy to .env.local and adjust as needed. Never commit .env.local.

# Where the browser sends API calls. Defaults to /api/web, which the Vite dev
# server proxies to VITE_API_TARGET below. Set to an absolute URL only when the
# frontend is served from a different origin than the API in production.
VITE_API_BASE_URL=/api/web

# Dev-only: the Express backend the /api proxy forwards to.
VITE_API_TARGET=http://localhost:8000

# Financial write guards.
#
# Each of these APIs is built and validated, but the button that triggers it
# stays disabled until the flow has been exercised against a TEST database.
# They move money or generate documents, so none is enabled by default.
# Set to "true" only once you have run the flow and checked the result.
VITE_ENABLE_BILL_GENERATION=false
VITE_ENABLE_RECEIPT_ENTRY=false
VITE_ENABLE_VILLAGE_PAYMENTS=false
