<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Allow plain http so a local backend (http://10.0.2.2:8000) can be
         reached. Android blocks cleartext by default from API 28 on.

         Debug manifest only, deliberately: the release build keeps the default
         and so refuses http, which is what stops a dev base URL from silently
         shipping. See lib/core/constant.dart. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
